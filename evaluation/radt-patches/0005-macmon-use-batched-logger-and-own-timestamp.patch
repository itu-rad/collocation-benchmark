 from multiprocessing import Process
 
 
 class MacmonThread(Process):
-    def __init__(self, run_id, experiment_id=88):
+    def __init__(self, run_id, mlflow_buffer=None, experiment_id=88):
+        # `mlflow_buffer` was missing here while benchmark.py constructs EVERY
+        # listener as listener_class(run_id, self._buffer_listeners) -- so the
+        # queue was landing in `experiment_id` and this listener fell through to
+        # a synchronous mlflow.log_metrics() per sample. It was the only
+        # listener off the batched path, and the default one on Apple silicon,
+        # i.e. exactly where a per-sample network round-trip could perturb the
+        # workload it is measuring.
         super(MacmonThread, self).__init__()
         self.run_id = run_id
+        self.mlflow_buffer = mlflow_buffer
         self.experiment_id = experiment_id
 
+    def _enqueue_metrics(self, metrics, timestamp_ms=None):
+        """Hand samples to the batched logger; fall back to a direct write."""
+        if self.mlflow_buffer:
+            ts = int(timestamp_ms) if timestamp_ms is not None else int(time.time() * 1000)
+            entries = [{"key": k, "value": v, "timestamp": ts, "step": 0}
+                       for k, v in metrics.items()]
+            try:
+                for e in entries:
+                    self.mlflow_buffer.put(e)
+                return
+            except Exception:
+                pass
+        mlflow.log_metrics(metrics)
+
     def run(self):
         mlflow.start_run(run_id=self.run_id).__enter__()  # attach to run
 
