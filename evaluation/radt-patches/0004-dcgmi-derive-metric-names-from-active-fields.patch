+# Map DCGM field id -> metric name, so names are derived from the fields
+# ACTUALLY requested rather than from a fixed list.
+#
+# The previous code zipped values against a flat 18-name list regardless of
+# which fallback field set was in use. The A10 set omits 1006 (FP64 Active),
+# so on that path every metric after "DRAM Active" was labelled with its
+# neighbour's name -- FP32 reported as FP64, FP16 as FP32, and so on. The
+# 18-field and 6-field sets happened to line up, which is why it went unseen.
+FIELD_NAMES = {
+    155: "Power Usage",
+    156: "Total Energy Consumption",
+    200: "PCIE TX Throughput",
+    201: "PCIE RX Throughput",
+    203: "GPU Utilization",
+    204: "Memory Copy Utilization",
+    1001: "GR Engine Active",
+    1002: "SM Active",
+    1003: "SM Occupancy",
+    1004: "Tensor Active",
+    1005: "DRAM Active",
+    1006: "FP64 Active",
+    1007: "FP32 Active",
+    1008: "FP16 Active",
+    1009: "PCIE TX Bytes",
+    1010: "PCIE RX Bytes",
+    1011: "NVlink TX Bytes",
+    1012: "NVlink RX Bytes",
+}
 
 
